<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/styles/estilos.css" />
    <script src="/static/js/config.js" defer></script>
    <script src="/static/js/functions.js" defer></script>
    <title>Panel de administrador</title>
</head>

<body>
    <header class="header">
        <nav class="menu">
            <%- include("../partials/navbar") %>
        </nav>
    </header>

    <main class="admin-container">
        <h1 class="admin-title">Panel de administración</h1>
        <h2 class="admin-subtitle">Bienvenido, <%= user.name %></h2>

        <form id="formulario_producto" method="post" action="/agregar-producto">
            <legend class="title">Nuevo producto</legend>
            <ul>
              <li>
                <label>Nombre</label>
                <input
                  type="text"
                  name="name"
                  class="input"
                  required
                  placeholder="nombre"
                  autofocus
                />
            </ul>
            <ul>
              <li>
                <label>Descripcion</label>
                <input
                  type="text"
                  name="description"
                  class="input"
                  required
                  placeholder="descripcion"
                />
            </ul>
            <ul>
              <li>
                <label>Cantidad</label>
                <input
                  type="number"
                  min="0" 
                  max="9999"
                  name="stock"
                  class="input"
                  required
                  placeholder="cantidad"
                />
            </ul>
            <ul>
              <li>
                <label>Precio</label>
                <input
                  type="number"
                  min="0" 
                  max="9999"
                  step="0.01"
                  name="price"
                  class="input"
                  required
                  placeholder="precio"
                />
            </ul>
            <ul>
              <li>
                <label>Fecha de creacion</label>
                <input
                  type="date"
                  name="creation_date"
                  class="input"
                  required
                  placeholder="fecha de creacion"
                />
            </ul>

            <button class="btn" type="submit">Enviar</button>
          </form>
        </hgroup>
        <div id="respuesta-formualrio">

            </div>
      </section>

        
    </main>
</body>
</html>