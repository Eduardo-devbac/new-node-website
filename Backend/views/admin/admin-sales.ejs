<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/styles/estilos.css" />
    <script src="/static/js/config.js" defer></script>
    <script src="/static/js/functions.js" defer></script>
    <title>Ventas</title>
</head>
<body>
    <header class="header">
        <nav class="menu">
            <%- include("../partials/navbar") %>
        </nav>
    </header>
     <main class="admin-container">
        <h1 class="admin-title">Panel de administración</h1>
        <h2 class="admin-subtitle">Bienvenido, <%= user.name %></h2>

        <div class="table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Id de la venta</th>
                        <th>Id del usuario</th>
                        <th>Total</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
  <% if (ventas) { %>

    <% for (let i = 0; i < ventas.length; i++) { %>
      <tr>
        <td><%= ventas[i].id_venta %></td>
        <td><%= ventas[i].id_usuario %></td>
        <td><%= ventas[i].total %></td>
        <td><%= ventas[i].fecha %></td>
      </tr>
    <% } %>

  <% } else { %>
      <tr>
        <td colspan="5" style="text-align:center; padding: 20px;">
          No hay usuarios registrados
        </td>
      </tr>
  <% } %>
</tbody>
            </table>
        </div>
    </main>
</body>
</html>