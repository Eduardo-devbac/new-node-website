<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tienda de Ciclismo</title>
    <link rel="stylesheet" href="/static/styles/estilos.css" />
    <script src="/static/js/functions.js" defer></script>
  </head>

  <body>
    <header>
      <nav>
        <%- include("partials/navbar") %>
      </nav>
    </header>

  <main>
    <div class="tienda-contenedor">
      <section class="title">
        <h1>Tienda de Ciclismo</h1>
        <p>Los mejores productos para tu bicicleta</p>
      </section>
        <section class="buscador-tienda">
  <input type="text" id="buscador-tienda" placeholder="Buscar productos...">
  <button id="busqueda-tienda" type="button">buscar</button>
</section>
 <section>
  <h2>Productos destacados</h2>

  <% if (productos.length === 0) { %>
    <p class="no-comentarios">Sin productos disponibles.</p>
  <% } else { %>

    <div class="cards">
      <% for (let i = 0; i < productos.length; i++) { %>
        <div class="card">
          <div class="card-body">
            <h3><%= productos[i].nombre %></h3>
            <p><%= productos[i].description %></p>
            <p class="price">$<%= productos[i].price %></p>
            <button 
              class="btn btn_sale"
              data-id="<%= productos[i].id_product %>"
              data-precio="<%= productos[i].price %>"
              data-nombre="<%= productos[i].nombre %>"
            >
              Agregar al carrito
            </button>
          </div>
        </div>
      <% } %>
    </div>

  <% } %>
</section>

<section class="lista-compra">
  <h2 class="title">Lista de compra</h2>
  <ul id="lista-compra" style="list-style: none; padding: 0"></ul>
  <p id="total">Total:</p>
  <button class="btn" id="btn-pay">
              Pagar
            </button>

            <div id="respuesta-formualrio">

            </div>
</section>
      </div>
    </main>

    <footer class="pie">
      <p>&copy; 2025 Tienda de Ciclismo. Todos los derechos reservados.</p>
    </footer>
  </body>
</html>
