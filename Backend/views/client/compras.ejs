<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/static/styles/estilos.css" />
    <script src="/static/js/functions.js" defer></script>
    <title>Compras</title>
  </head>

  <body>
    <header class="header">
      <nav class="menu">
        <%- include("../partials/navbar") %>
      </nav>
    </header>

    <main class="main">
      <section class="seccion">
        <div>
          <h1>Mis compras</h1>

          <% if (compras.length === 0) { %>
            <p class="no-comentarios">Todavía no has hecho ninguna compra.</p>
          <% } else { %>

            <% for (let i = 0; i < compras.length; i++) { %>
              <div class="comentario-card">

                <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cantidad</th>
                        <th>Precio_unitario</th>
                        <th>Sub total</th>
                        <th>Fecha</th>
                        <th>Identificador de la venta</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                <td class="comentario-texto"> <%= compras[i].producto %></td>
                <td class="comentario-texto"> <%= compras[i].cantidad %></td>
                <td  class="comentario-texto"> <%= compras[i].precio_unitario %></td>
                <td  class="comentario-texto"> <%= compras[i].subtotal %></td>
                <td  class="comentario-texto"> <%= compras[i].fecha %></td>
                <td  class="comentario-texto"> <%= compras[i].id_venta %></td>
                </tr>
                    </tbody>
              </div>
            <% } %>

          <% } %>

        </div>
      </section>
    </main>

    <footer class="pie">
      <!-- <p>&copy; 2025 Tienda de Ciclismo. Todos los derechos reservados.</p> -->
    </footer>
  </body>
</html>