<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/static/styles/estilos.css" />
    <script src="/static/js/functions.js" defer></script>
    <title>Comentarios</title>
  </head>

  <body>
    <header class="header">
      <nav class="menu">
            <%- include("../partials/navbar") %>
      </nav>
    </header>

    <main class="main">

      <section class="comentarios-section">
  <h1>Mis comentarios</h1>

  <% if (comentarios.length === 0) { %>
    <p class="no-comentarios">Todavía no has hecho ningún comentario.</p>
  <% } else { %>

    <% for (let i = 0; i < comentarios.length; i++) { %>
      <div class="comentario-card">
        <p class="comentario-fecha"><%= comentarios[i].fecha.toLocaleString() %></p>
        <p class="comentario-texto"><%= comentarios[i].contenido %></p>
      </div>
    <% } %>

  <% } %>
</section>

    </main>

    <footer class="pie">
      <p>&copy; 2025 Tienda de Ciclismo. Todos los derechos reservados.</p>
    </footer>
  </body>
</html>